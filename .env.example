# ==============================================================================
# .env.example — Mẫu biến môi trường chuẩn cho dự án TripMate AI
# Copy file này thành .env và điền các giá trị thật.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env THỰC TẾ LÊN GIT.
# ==============================================================================

# --- Cấu hình Server (FastAPI / Uvicorn ASGI) ---
PROJECT_NAME="TripMate AI: Intelligent Group Activity & Travel Planning Platform"
ENVIRONMENT=development
PORT=8000
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:5173

# --- Cơ sở dữ liệu Supabase (PostgreSQL 16 + pgvector) ---
# 1. Chuỗi kết nối qua Supavisor Pooler (Port 6543, Transaction Mode) - Dùng khi chạy ứng dụng
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Chuỗi kết nối trực tiếp Direct Connection (Port 5432) - Chỉ dùng cho Alembic migration
DIRECT_URL=postgresql+asyncpg://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# --- Hàng đợi & Bộ nhớ đệm (Upstash Redis 7 Serverless) ---
# Kết nối Redis hỗ trợ TLS (rediss://)
REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379

# --- Xác thực & Bảo mật (Supabase Auth & JWT) ---
SECRET_KEY=change-me-to-a-super-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# --- AI Agent Layer (DeepSeek-V4 & Model Abstraction Fallback) ---
# Động cơ chính: DeepSeek-V4
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_PRIMARY=deepseek-v4

# Mô hình dự phòng tự động (Model Abstraction Fallback)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-gemini-key

AI_MAX_TOKENS_PER_REQUEST=4096
AI_MAX_STEPS_PER_SESSION=15

# --- External Travel APIs ---
GOOGLE_PLACES_API_KEY=your-google-places-api-key
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-access-token
OPENWEATHER_API_KEY=your-openweathermap-key
EXCHANGE_RATE_API_KEY=your-exchangerate-key

# --- Lớp Ngắt Mạch Kháng Lỗi (PyBreaker Circuit Breaker) ---
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_CALL_TIMEOUT_SECONDS=2.5

# --- Email & SMTP (Gửi thư mời & Thông báo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAILS_FROM_EMAIL=no-reply@tripmate.ai
EMAILS_FROM_NAME="TripMate AI Notification"

# --- Giám Sát & Truy Vết (OpenTelemetry & LangSmith) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=tripmate-ai

# --- Frontend Vite (Các biến VITE_* được bundle vào code client, KHÔNG CHỨA SECRET) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_USE_MOCK=false
VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-access-token
VITE_APP_URL=http://localhost:5173
